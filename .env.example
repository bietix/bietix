# ════════════════════════════════════════════════════════════════════
#  Copiá este archivo como .env y completalo. El .env NUNCA se sube a GitHub.
#  NUNCA pongas claves privadas acá: se firma con una cuenta cifrada
#  (cast wallet import) o con una hardware wallet (--ledger).
# ════════════════════════════════════════════════════════════════════

# ─── RPC ───
ARBITRUM_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

# ─── Verificación de contratos en Arbiscan (API key de etherscan.io, sirve para Arbitrum) ───
ETHERSCAN_API_KEY=

# ─── Gobierno (obligatorio) ───
# Safe multisig (en mainnet tiene que estar creado antes de desplegar)
SAFE_ADDRESS=
# Billetera del guardián (distinta del Safe y de quien despliega)
GUARDIAN_ADDRESS=
# Tesorería que recibe las comisiones (puede ser el mismo Safe)
TREASURY_ADDRESS=
# Espera del timelock en segundos: testnet 300 (5 min) · mainnet Fase 2: 86400 (24 h) · Fase 3: 172800 (48 h)
TIMELOCK_DELAY=86400

# ─── Solo mainnet (script/Deploy.s.sol) ───
# Antigüedad máxima de cada feed en segundos = heartbeat publicado por Chainlink + 10-25% de tolerancia.
# Revisar los heartbeats en https://docs.chain.link/data-feeds/price-feeds/addresses?network=arbitrum
BTC_STALENESS=
ETH_STALENESS=
WBTC_BTC_STALENESS=
STABLE_STALENESS=
# Unidades por BIETIX. UNIT_BTC en sats (10000 = 0,0001 BTC). UNIT_ETH en wei: fijarlo el día del lanzamiento
# para que quede 50/50 (la simulación del script muestra el valor calculado).
UNIT_BTC=10000
UNIT_ETH=
# Límite de supply en BIETIX con 18 decimales. Ej.: 3200 BIETIX (~$50K) = 3200000000000000000000
SUPPLY_CAP=
# Agregadores habilitados, separados por coma (ej.: router de Uniswap V3 en Arbitrum)
SWAP_TARGETS=0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45
# Opcionales (valores por defecto entre paréntesis)
# VAULT_FEE_BPS=5  BUY_FEE_BPS=25  SELL_FEE_BPS=30  MAX_TRADE_USD=25000  SELL_LIMIT_USD=50000
